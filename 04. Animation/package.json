{
  "name": "betaalbuddy-ig-ad",
  "version": "1.0.0",
  "private": true,
  "description": "BetaalBuddy Instagram ad animation, built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render BB-Ad-Reel out/BB-Ad-Reel.mp4",
    "render:feed": "remotion render BB-Ad-Feed out/BB-Ad-Feed.mp4",
    "render:countdown": "remotion render BB-Countdown-Reel out/BB-Countdown-Reel.mp4",
    "render:countdown:feed": "remotion render BB-Countdown-Feed out/BB-Countdown-Feed.mp4",
    "render:privacy": "remotion render BB-Privacy-Reel out/BB-Privacy-Reel.mp4",
    "render:privacy:feed": "remotion render BB-Privacy-Feed out/BB-Privacy-Feed.mp4",
    "render:boemerang": "remotion render BB-Boemerang-Reel out/boemerang-reel-vo.mp4",
    "render:achteraf-bf": "remotion render BB-K1Achteraf-Reel out/BB-K1Achteraf-Reel.mp4",
    "render:achteraf-bf:feed": "remotion render BB-K1Achteraf-Feed out/BB-K1Achteraf-Feed.mp4",
    "render:twaalf-52": "remotion render BB-K2Twaalf-Reel out/BB-K2Twaalf-Reel.mp4",
    "render:twaalf-52:feed": "remotion render BB-K2Twaalf-Feed out/BB-K2Twaalf-Feed.mp4",
    "render:all": "npm run render && npm run render:feed && npm run render:countdown && npm run render:countdown:feed && npm run render:privacy && npm run render:privacy:feed && npm run render:boemerang && npm run render:achteraf-bf && npm run render:achteraf-bf:feed && npm run render:twaalf-52 && npm run render:twaalf-52:feed",
    "still": "remotion still BB-Ad-Reel out/BB-Ad-Reel-cover.png --frame=72",
    "still:countdown": "remotion still BB-Countdown-Reel out/BB-Countdown-Reel-cover.png --frame=66",
    "still:privacy": "remotion still BB-Privacy-Reel out/BB-Privacy-Reel-cover.png --frame=78",
    "still:achteraf-bf": "remotion still BB-K1Achteraf-Reel out/BB-K1Achteraf-Reel-cover.png --frame=170",
    "still:twaalf-52": "remotion still BB-K2Twaalf-Reel out/BB-K2Twaalf-Reel-cover.png --frame=200",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
