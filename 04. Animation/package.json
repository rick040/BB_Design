{
  "name": "betaalbuddy-ig-ad",
  "version": "1.0.0",
  "private": true,
  "description": "BetaalBuddy Instagram ad animation, built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render BB-Ad-Reel out/BB-Ad-Reel.mp4",
    "render:feed": "remotion render BB-Ad-Feed out/BB-Ad-Feed.mp4",
    "render:countdown": "remotion render BB-Countdown-Reel out/BB-Countdown-Reel.mp4",
    "render:countdown:feed": "remotion render BB-Countdown-Feed out/BB-Countdown-Feed.mp4",
    "render:privacy": "remotion render BB-Privacy-Reel out/BB-Privacy-Reel.mp4",
    "render:privacy:feed": "remotion render BB-Privacy-Feed out/BB-Privacy-Feed.mp4",
    "render:ruis": "remotion render BB-Ruis-Reel out/ruis-reel-vo.mp4",
    "render:ruis:feed": "remotion render BB-Ruis-Feed out/ruis-feed-vo.mp4",
    "render:ruis:stil": "remotion render BB-Ruis-Reel out/ruis-reel-stil.mp4 --props='{\"voice\":{\"withVoice\":false,\"src\":\"vo/ruis/voice-over.mp3\",\"volume\":1,\"s2\":134,\"s3\":179,\"s4\":225,\"end\":280}}'",
    "render:ruis:feed:stil": "remotion render BB-Ruis-Feed out/ruis-feed-stil.mp4 --props='{\"voice\":{\"withVoice\":false,\"src\":\"vo/ruis/voice-over.mp3\",\"volume\":1,\"s2\":134,\"s3\":179,\"s4\":225,\"end\":280}}'",
    "render:all": "npm run render && npm run render:feed && npm run render:countdown && npm run render:countdown:feed && npm run render:privacy && npm run render:privacy:feed && npm run render:ruis && npm run render:ruis:feed",
    "still": "remotion still BB-Ad-Reel out/BB-Ad-Reel-cover.png --frame=72",
    "still:countdown": "remotion still BB-Countdown-Reel out/BB-Countdown-Reel-cover.png --frame=66",
    "still:privacy": "remotion still BB-Privacy-Reel out/BB-Privacy-Reel-cover.png --frame=78",
    "still:ruis": "remotion still BB-Ruis-Reel out/ruis-cover.png --frame=118",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
